# Copy to .env and fill in. .env is gitignored.

# Hostname or IP of your Hue bridge. Find it at https://discovery.meethue.com
# or in the Hue app under Settings → My Hue System.
HUE_BRIDGE_HOST=192.168.1.2

# Application key (a.k.a. "username") returned by the bridge when you press the
# link button and POST to /api with `{"devicetype": "...", "generateclientkey": true}`.
HUE_APPLICATION_KEY=replace-with-generated-key

# The bridge presents a self-signed certificate signed by the Philips Hue root
# CA. Set to 1 to verify against the system trust store (only useful if you've
# installed the Hue root CA), or to a path of a CA bundle to pin it.
# Defaults to 0 (skip verification — appropriate for a LAN-local bridge).
# HUE_VERIFY_TLS=0

# Optional request timeout in seconds. Defaults to 10.
# HUE_TIMEOUT=10
